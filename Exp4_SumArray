import java.util.Scanner;

public class SumArray {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input array size
        System.out.print("Enter number of elements: ");
        int n = sc.nextInt();

        int[] arr = new int[n];

        // Input array elements
        System.out.println("Enter " + n + " elements:");
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // Sum of all elements
        int totalSum = 0;
        for (int i = 0; i < n; i++) {
            totalSum += arr[i];
        }

        // Sum of alternate elements
        int alternateSum = 0;
        for (int i = 0; i < n; i += 2) {   // take elements at index 0,2,4...
            alternateSum += arr[i];
        }

        // Output results
        System.out.println("Sum of all elements = " + totalSum);
        System.out.println("Sum of alternate elements (0,2,4..) = " + alternateSum);

        sc.close();
    }
}
